{
  "name": "source-scraper-obsidian",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Obsidian client for Source Scraper JSON",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "build": "node esbuild.config.mjs",
    "package": "npm run check && npm test && npm run build",
    "test:desktop": "npm --prefix tests/desktop test"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
