diff --git a/src/vaultasmcp-ToolProviders.ts b/src/vaultasmcp-ToolProviders.ts
new file mode 100644
index 0000000..28cb8cc
--- /dev/null
+++ b/src/vaultasmcp-ToolProviders.ts
@@ -0,0 +1,86 @@
+import type { MCPTool } from "./@types/settings";
+
+export interface ToolProvider {
+    apiVersion: 1;
+    id: string;
+    tools: MCPTool[];
+    execute(name: string, args: Record<string, unknown>): Promise<unknown>;
+}
+
+/** Trusted local plugins only. Enablement is local configuration, never an MCP tool. */
+export class ToolProviders {
+    private providers = new Map<string, ToolProvider>();
+    constructor(private enabled: () => readonly string[] = () => []) {}
+
+    register(provider: ToolProvider): () => void {
+        if (
+            provider.apiVersion !== 1 ||
+            !/^[a-z][a-z0-9-]{1,63}$/.test(provider.id)
+        )
+            throw new Error("Unsupported tool provider");
+        if (!this.enabled().includes(provider.id))
+            throw new Error("Tool provider is not locally enabled");
+        if (this.providers.has(provider.id))
+            throw new Error("Tool provider already registered");
+        const prefix = `${provider.id.replaceAll("-", "_")}_`;
+        const tools = structuredClone(provider.tools);
+        if (
+            !tools.length ||
+            tools.length > 64 ||
+            new Set(tools.map((t) => t.name)).size !== tools.length
+        )
+            throw new Error("Invalid provider definitions");
+        for (const tool of tools) {
+            if (
+                !tool.name.startsWith(prefix) ||
+                !/^[a-z0-9_]{1,100}$/.test(tool.name) ||
+                tool.inputSchema.type !== "object" ||
+                !tool.inputSchema.properties
+            )
+                throw new Error("Invalid namespaced tool definition");
+        }
+        const registered = {
+            ...provider,
+            tools,
+            execute: provider.execute.bind(provider),
+        };
+        this.providers.set(provider.id, registered);
+        return () => {
+            if (this.providers.get(provider.id) === registered)
+                this.providers.delete(provider.id);
+        };
+    }
+
+    definitions(): MCPTool[] {
+        return structuredClone(
+            [...this.providers.values()]
+                .filter((p) => this.enabled().includes(p.id))
+                .flatMap((p) => p.tools),
+        );
+    }
+
+    async execute(
+        name: string,
+        args: Record<string, unknown>,
+    ): Promise<unknown> {
+        const provider = [...this.providers.values()].find(
+            (p) =>
+                this.enabled().includes(p.id) &&
+                p.tools.some((t) => t.name === name),
+        );
+        const tool = provider?.tools.find((t) => t.name === name);
+        if (!provider || !tool)
+            throw new Error("Unknown or disabled provider tool");
+        if (
+            !args ||
+            typeof args !== "object" ||
+            Array.isArray(args) ||
+            Object.keys(args).some(
+                (key) => !Object.hasOwn(tool.inputSchema.properties, key),
+            ) ||
+            tool.inputSchema.required?.some((key) => !Object.hasOwn(args, key))
+        )
+            throw new Error("Invalid provider arguments");
+        return provider.execute(name, args);
+    }
+}
diff --git a/test/vaultasmcp-ProviderHttp.test.ts b/test/vaultasmcp-ProviderHttp.test.ts
new file mode 100644
index 0000000..b56116b
--- /dev/null
+++ b/test/vaultasmcp-ProviderHttp.test.ts
@@ -0,0 +1,34 @@
+import {App} from "obsidian";
+import {it,expect,vi} from "vitest";
+import {MCPServer} from "../src/vaultasmcp-Server";
+import {ToolProviders} from "../src/vaultasmcp-ToolProviders";
+import type {CurrentSettings,Logger} from "../src/@types/settings";
+vi.mock("obsidian-daily-notes-interface",()=>({}));
+
+it("discovers and invokes a locally registered provider through the existing authenticated HTTP endpoint",async()=>{
+  const logger={debug:vi.fn(),warn:vi.fn(),warnAcl:vi.fn(),error:vi.fn()} as unknown as Logger;
+  const current={pathACL:()=>({forbidden:[],readOnly:[],writable:[]}),bearerToken:()=>"synthetic-test-token",
+    serverPort:()=>0,serverHost:()=>"127.0.0.1",serverVersion:()=>"1.2.0",normalizeQuotes:()=>true,
+    tlsEnabled:()=>false,tlsCertificatePem:()=>undefined,getTlsPrivateKeyPem:()=>undefined} as CurrentSettings;
+  const registry=new ToolProviders(()=>["source-scraper"]);
+  const dispose=registry.register({apiVersion:1,id:"source-scraper",tools:[{name:"source_scraper_capabilities",description:"test",
+    inputSchema:{type:"object",properties:{},required:[]}}],execute:async()=>({apiVersion:1,notesCreated:0})});
+  const app=App.createConfigured__({files:{"References.md":"sentinel"}});
+  const server=new MCPServer(app.asOriginalType__(),logger,current,registry);
+  await server.start();
+  try{
+    const port=(server as any).server.server.address().port;
+    const endpoint="http://127.0.0.1:"+port+"/mcp";
+    const rpc=async(method:string,params={},authorized=true)=>{
+      const response=await fetch(endpoint,{method:"POST",headers:{"Content-Type":"application/json",...(authorized?{Authorization:"Bearer synthetic-test-token"}:{})},
+        body:JSON.stringify({jsonrpc:"2.0",id:1,method,params})});return {status:response.status,body:await response.json() as any};
+    };
+    expect((await rpc("tools/list",{},false)).status).toBe(401);
+    const listed=await rpc("tools/list");
+    expect(listed.body.result.tools.some((t:any)=>t.name==="read_note")).toBe(true);
+    expect(listed.body.result.tools.some((t:any)=>t.name==="source_scraper_capabilities")).toBe(true);
+    expect((await rpc("tools/call",{name:"source_scraper_capabilities",arguments:{}})).body.result.structuredContent).toEqual({apiVersion:1,notesCreated:0});
+    expect((await rpc("tools/call",{name:"source_scraper_capabilities",arguments:{shell:"forbidden"}})).body.result.isError).toBe(true);
+    dispose();expect((await rpc("tools/list")).body.result.tools.some((t:any)=>t.name==="source_scraper_capabilities")).toBe(false);
+  }finally{await server.stop();}
+});
diff --git a/test/vaultasmcp-ToolProviders.test.ts b/test/vaultasmcp-ToolProviders.test.ts
new file mode 100644
index 0000000..a0defac
--- /dev/null
+++ b/test/vaultasmcp-ToolProviders.test.ts
@@ -0,0 +1,37 @@
+import {describe,it,expect} from "vitest";
+import {ToolProviders} from "../src/vaultasmcp-ToolProviders";
+
+describe("trusted local tool providers",()=>{
+  it("accepts a complete 33-tool provider and retains a bounded 64-tool ceiling",()=>{
+    const tools=(count:number)=>Array.from({length:count},(_,i)=>({name:`source_scraper_tool_${i}`,description:"test",inputSchema:{type:"object" as const,properties:{},required:[]}}));
+    for(const count of [33,64]){const registry=new ToolProviders(()=>["source-scraper"]);registry.register({apiVersion:1,id:"source-scraper",tools:tools(count),execute:async()=>({})});expect(registry.definitions()).toHaveLength(count);}
+    expect(()=>new ToolProviders(()=>["source-scraper"]).register({apiVersion:1,id:"source-scraper",tools:tools(65),execute:async()=>({})})).toThrow(/Invalid provider definitions/);
+  });
+  const provider=()=>({apiVersion:1 as const,id:"source-scraper",tools:[{
+    name:"source_scraper_capabilities",description:"read",inputSchema:{type:"object" as const,properties:{},required:[]}
+  }],execute:async()=>({ready:true})});
+  it("retains class prototype handlers and their instance binding",async()=>{
+    class PluginProvider {
+      apiVersion=1 as const;id="source-scraper";tools=provider().tools;
+      async execute(){return {provider:this.id};}
+    }
+    const registry=new ToolProviders(()=>["source-scraper"]);registry.register(new PluginProvider());
+    await expect(registry.execute("source_scraper_capabilities",{})).resolves.toEqual({provider:"source-scraper"});
+  });
+  it("requires local enablement and cannot replace built-in names",()=>{
+    expect(()=>new ToolProviders().register(provider())).toThrow(/locally enabled/);
+    const registry=new ToolProviders(()=>["source-scraper"]),bad=provider();bad.tools[0].name="create_note";
+    expect(()=>registry.register(bad)).toThrow(/namespaced/);
+  });
+  it("supports dispatch, revocation, argument checks and disposal",async()=>{
+    let enabled=["source-scraper"];const registry=new ToolProviders(()=>enabled),p=provider();
+    const dispose=registry.register(p);p.tools[0].name="tampered";
+    expect(registry.definitions()[0].name).toBe("source_scraper_capabilities");
+    expect(()=>registry.register(provider())).toThrow(/already registered/);
+    await expect(registry.execute("source_scraper_capabilities",{})).resolves.toEqual({ready:true});
+    await expect(registry.execute("source_scraper_capabilities",{shell:"arbitrary"})).rejects.toThrow(/arguments/);
+    enabled=[];expect(registry.definitions()).toEqual([]);
+    await expect(registry.execute("source_scraper_capabilities",{})).rejects.toThrow(/disabled/);
+    enabled=["source-scraper"];dispose();expect(registry.definitions()).toEqual([]);
+  });
+});
